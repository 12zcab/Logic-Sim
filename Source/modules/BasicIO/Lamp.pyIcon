import math

state_list = [Logic.ZERO]
width = 1
colour = "#38bdf8"
showNumber = True

if 'node' in globals() and node is not None and hasattr(node, 'metadata') and node.metadata is not None:
    if hasattr(node.metadata, "width"):
        width = max(1, int(node.metadata.width))
    elif hasattr(node.metadata, "_width"):
        width = max(1, int(node.metadata._width))

    if hasattr(node.metadata, "state"):
        raw_state = node.metadata.state
        if isinstance(raw_state, list):
            state_list = raw_state
        else:
            state_list = [raw_state]

    if hasattr(node.metadata, "colour"):
        colour = node.metadata.colour
    if hasattr(node.metadata, "showNumber"):
        showNumber = node.metadata.showNumber

if len(state_list) < width:
    state_list = state_list + [Logic.ZERO] * (width - len(state_list))

color_map = {
    Logic.ONE: colour,
    Logic.X: "#f8bd38",
    Logic.ZERO: "#161616",
    Logic.Z: "black"
}

is_selected = 'is_selected' in globals() and is_selected

outer_corners = [
    (x, y),
    (x + w, y),
    (x + w, y + h),
    (x, y + h)
]

shadow_offset = min(w, h / float(width)) * 0.06
shadow_corners = [
    (x + shadow_offset, y + shadow_offset),
    (x + w + shadow_offset, y + shadow_offset),
    (x + w + shadow_offset, y + h + shadow_offset),
    (x + shadow_offset, y + h + shadow_offset)
]
rot_shadow = [rotatePoint(px, py, cx, cy, angle) for px, py in shadow_corners]
flat_shadow = [coord for pt in rot_shadow for coord in pt]

canvas.create_polygon(
    flat_shadow,
    fill="#000000",
    outline="",
    tags=tags
)

row_h = h / float(width)
font_size = int(12 * (zoom / 35.0))
stroke_w = max(1, int(min(w, row_h) * 0.04))

for r in range(width):
    value = state_list[r]
    ry1 = y + (r * row_h)
    ry2 = ry1 + row_h

    cell_corners = [
        (x, ry1),
        (x + w, ry1),
        (x + w, ry2),
        (x, ry2)
    ]
    rot_cell = [rotatePoint(px, py, cx, cy, angle) for px, py in cell_corners]
    flat_cell = [coord for pt in rot_cell for coord in pt]

    bg_fill = color_map.get(value, "#114C06")
    text_color = "#000000" if value == Logic.ONE else "#777777"
    border_color = colour if value == Logic.ONE else "#333333"

    canvas.create_polygon(
        flat_cell,
        fill=bg_fill,
        outline=border_color,
        width=stroke_w,
        tags=tags
    )

    if font_size > 0 and showNumber:
        center_pt = rotatePoint(x + w / 2.0, ry1 + row_h / 2.0, cx, cy, angle)
        canvas.create_text(
            center_pt[0], center_pt[1],
            text=value,
            fill=text_color,
            font=("Consolas", font_size, "bold"),
            tags=tags
        )

rot_outer = [rotatePoint(px, py, cx, cy, angle) for px, py in outer_corners]
flat_outer = [coord for pt in rot_outer for coord in pt]

canvas.create_polygon(
    flat_outer,
    fill="",
    outline="#38bdf8" if is_selected else "#444444",
    width=max(2, int(2 * (zoom / 35.0))) if is_selected else stroke_w,
    tags=tags
)