                "x": 2.5,
                "y": 0.5,
                "angle": 0.0,
                "width": 1.0,
                "height": 1.0,
                "bg_color": "transparent",
                "border_color": "transparent",
                "graphic_code": "import math\n\nis_on = False\nif 'node' in globals() and node is not None and hasattr(node, 'metadata') and node.metadata is not None:\n    if hasattr(node.metadata, \"state\"):\n        is_on = bool(node.metadata.state)\n\nbox_w = w * (6.0 / 5.0)\nbox_h = h * (6.0 / 5.0)\nbox_x1 = x + (w - box_w) / 2.0\nbox_y1 = y + (h - box_h) / 2.0\nbox_x2 = box_x1 + box_w\nbox_y2 = box_y1 + box_h\n\ncorners = [\n    (box_x1, box_y1),\n    (box_x2, box_y1),\n    (box_x2, box_y2),\n    (box_x1, box_y2)\n]\n\nshadow_offset = box_w * 0.06\nshadow_corners = [\n    (box_x1 + shadow_offset, box_y1 + shadow_offset),\n    (box_x2 + shadow_offset, box_y1 + shadow_offset),\n    (box_x2 + shadow_offset, box_y2 + shadow_offset),\n    (box_x1 + shadow_offset, box_y2 + shadow_offset)\n]\n\nrot_corners = [rotatePoint(px, py, cx, cy, angle) for px, py in corners]\nflat_box = [coord for pt in rot_corners for coord in pt]\n\nflat_shadow = [coord for pt in shadow_corners for coord in pt]\n\nstroke_w = max(2, int(min(box_w, box_h) * 0.05))\nselect_w = stroke_w + max(2, int(min(box_w, box_h) * 0.04))\n\nif is_selected:\n    canvas.create_polygon(\n        flat_box,\n        fill=\"\",\n        outline=\"#38bdf8\",\n        width=select_w,\n        smooth=True,\n        splinesteps=32,\n        tags=tags\n    )\n\ncanvas.create_polygon(\n    flat_shadow,\n    fill=\"#000000\",\n    outline=\"\",\n    smooth=True,\n    splinesteps=32,\n    tags=tags\n)\n\nbg_fill = \"#38bdf8\" if is_on else \"#000000\"\ntext_color = \"#000000\" if is_on else \"#FFFFFF\"\nborder_color = \"#38bdf8\" if is_on else \"#FFFFFF\"\n\ncanvas.create_polygon(\n    flat_box,\n    fill=bg_fill,\n    outline=border_color,\n    width=stroke_w,\n    smooth=True,\n    splinesteps=32,\n    tags=tags\n)\n\ntext_str = \"ON\" if is_on else \"OFF\"\ncenter_pt = rotatePoint(x + w / 2.0, y + h / 2.0, cx, cy, angle)\nfont_size = int(8 * (zoom / 35.0))\n\nif font_size > 0:\n    canvas.create_text(\n        center_pt[0], center_pt[1],\n        text=text_str,\n        fill=text_color,\n        font=(\"Consolas\", font_size, \"bold\"),\n        tags=tags\n    )"
            }
